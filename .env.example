# ── Database (Neon free tier — use the POOLED connection string) ──
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── Admin sign-in (Better Auth). Long random string: `openssl rand -hex 32` ──
AUTH_SECRET=
# First admin account, created by `bun run seed` (change the password after first sign-in)
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# ── Optional: sign in with Google / GitHub (each button appears when its keys are set).
# Invite-only: the provider's email must belong to a user you've invited in Settings → Users.
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web).
#   Authorised redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: github.com/settings/developers → New OAuth App.
#   Authorization callback URL: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Media storage (Cloudflare R2 free tier). Leave blank to store uploads in public/uploads in dev. ──
# The admin uploads straight from the browser with a presigned PUT, so add a CORS rule on the bucket:
#   AllowedOrigins: your site URL(s) · AllowedMethods: PUT · AllowedHeaders: content-type
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Public bucket URL (r2.dev or custom domain), used to serve files directly
R2_PUBLIC_URL=

# ── Email (Resend free tier). Without a key, messages are still saved in the admin inbox
#    and magic-link sign-in is hidden. ──
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# ── Public URL used for metadata, sitemap, OG images, auth callbacks and live preview ──
# On Vercel set this to your real URL (e.g. https://your-site.vercel.app), then REDEPLOY:
# NEXT_PUBLIC_ values are baked in at build time. Sign-in fails with "Invalid origin" if it
# doesn't match the address in the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: extra origins allowed to sign in, comma-separated (e.g. a second custom domain)
AUTH_TRUSTED_ORIGINS=
# Sign-in is off on Vercel *preview* deployments (unreviewed branch code + production data).
# Set to 1 only if previews use their own database (a Neon branch as the Preview DATABASE_URL).
AUTH_ALLOW_PREVIEW_SIGNIN=

# ── Vercel Cron (message retention). Any random string; Vercel sends it as a Bearer token. ──
CRON_SECRET=

# ── Read-only demo (optional). Anyone can sign in with the demo account shown on /admin/login;
#    every change is refused. Seed the demo account with SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD. ──
DEMO_MODE=
DEMO_EMAIL=
DEMO_PASSWORD=
