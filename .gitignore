# ─── Secrets ──────────────────────────────────────────────
# Every env file except the documented template. Never commit keys.
.env
.env.*
!.env.example
*.pem
*.key

# ─── Dependencies ─────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases

# ─── Next.js / build output ───────────────────────────────
/.next/
/out/
/build/
next-env.d.ts
*.tsbuildinfo
.turbo/
.vercel/

# ─── Local uploads (production uses Cloudflare R2) ────────
/public/uploads/
/media/
/public/media/

# ─── Testing ──────────────────────────────────────────────
/coverage/
/playwright-report/
/test-results/
/blob-report/

# ─── Logs ─────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ─── Archives and backups (sync tarballs, DB dumps) ───────
*.tgz
*.tar.gz
*.zip
*.dump
*.sql.gz
*.bak

# ─── OS / editor ──────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# ─── Personal files kept out of the repo ─────────────────
/seed/assets/*.pdf
